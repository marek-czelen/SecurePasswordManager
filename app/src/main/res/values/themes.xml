<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Shared SecureVault theme. Light/dark tokens resolve from values(-night)/colors.xml. -->
    <style name="Base.Theme.SecurePasswordManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- Typography: slightly heavier headings for a crisper, professional look. -->
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Spm.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Spm.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Spm.TitleLarge</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Spm.LabelLarge</item>

        <!-- Shapes. -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Spm.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Spm.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Spm.Large</item>

        <!-- Component defaults. -->
        <item name="toolbarStyle">@style/Widget.Spm.Toolbar</item>
        <item name="materialButtonStyle">@style/Widget.Spm.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Spm.Card</item>
        <item name="textInputStyle">@style/Widget.Spm.TextInputLayout</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.Spm.ExtendedFab</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Spm.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.SecurePasswordManager.Dialog</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.SecurePasswordManager" parent="Base.Theme.SecurePasswordManager" />

    <!-- Typography. -->
    <style name="TextAppearance.Spm.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Spm.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="TextAppearance.Spm.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Spm.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Spm.ToolbarTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.Spm.SectionLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Shapes. -->
    <style name="ShapeAppearance.Spm.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.Spm.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Spm.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Spm.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Spm.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearance.Spm.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Dialogs. -->
    <style name="Theme.SecurePasswordManager.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spm.Dialog</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Spm</item>
    </style>

    <style name="MaterialAlertDialog.Spm" parent="MaterialAlertDialog.Material3">
        <item name="backgroundTint">@color/spm_dialog</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Spm.Dialog</item>
    </style>

    <!-- Bottom sheets. -->
    <style name="ThemeOverlay.Spm.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Spm.BottomSheet</item>
        <item name="android:navigationBarColor">@color/spm_sheet</item>
    </style>

    <style name="Widget.Spm.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/spm_sheet</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Spm.BottomSheet</item>
    </style>

    <!-- Toolbar. -->
    <style name="Widget.Spm.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Spm.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <!-- Cards. -->
    <style name="Widget.Spm.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/spm_card</item>
        <item name="strokeColor">@color/spm_card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Spm.Large</item>
    </style>

    <!-- Buttons. -->
    <style name="Widget.Spm.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.Spm.Button.Icon" parent="Widget.Material3.Button.Icon">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Spm.Button.Tonal" parent="Widget.Material3.Button.TonalButton.Icon">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Spm.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton.Icon">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="iconGravity">textStart</item>
        <item name="strokeColor">@color/spm_input_stroke_default</item>
    </style>

    <style name="Widget.Spm.Button.Text" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="cornerRadius">14dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Spm.ExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spm.Fab</item>
    </style>

    <!-- Text fields. -->
    <style name="Widget.Spm.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColor">@color/spm_input_stroke</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Spm.SearchField" parent="Widget.Spm.TextInputLayout">
        <item name="boxCornerRadiusTopStart">26dp</item>
        <item name="boxCornerRadiusTopEnd">26dp</item>
        <item name="boxCornerRadiusBottomStart">26dp</item>
        <item name="boxCornerRadiusBottomEnd">26dp</item>
        <item name="boxBackgroundColor">@color/spm_card</item>
        <item name="hintEnabled">false</item>
    </style>
</resources>