<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_field_tile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="2dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/emergencyPasswordValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="middle"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/toggleEmergencyPassword"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_visibility"
        app:iconTint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/action_show" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/copyEmergencyPassword"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_copy"
        app:iconTint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/cd_copy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteEmergencyPassword"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_delete"
        app:iconTint="?attr/colorError"
        android:contentDescription="@string/action_delete" />
</LinearLayout>
