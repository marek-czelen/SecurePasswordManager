<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/imageCropRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="@string/image_crop_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.example.securepasswordmanager.SelectionOverlayView
        android:id="@+id/imageOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelImage"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/action_cancel" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmImage"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="2"
            android:layout_marginStart="8dp"
            android:text="@string/image_crop_confirm"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
