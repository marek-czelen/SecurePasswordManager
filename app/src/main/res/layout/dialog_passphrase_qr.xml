<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/passphraseQrImage"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_margin="16dp"
            android:contentDescription="@string/cd_qr" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/passphrase_qr_warning"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePassphraseQr"
        style="@style/Widget.Spm.Button.Tonal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/action_share_jpg"
        app:icon="@drawable/ic_image"
        app:iconGravity="textStart" />
</LinearLayout>
