    <string name="help_intro">This guide explains the app. The buttons below open the real features so you can try them immediately.</string>
    <string name="help_list_title">1. One entry list</string>
    <string name="help_list_text">Password and image entries appear in one list. Search covers names, logins, URLs, folders and tags.</string>
    <string name="help_add_action">Open Add</string>
    <string name="help_images_title">2. Adding an image</string>
    <string name="help_images_text">Choose the camera or gallery, crop the photo with zoom, name it and save it. Only the cropped JPG is encrypted in the vault.</string>
    <string name="help_images_action">Open image adding</string>
    <string name="help_security_title">3. Security</string>
    <string name="help_security_text">Biometrics are the default on a configured device. Auto-lock is configurable. TOTP is optional and appears only after Show code.</string>
    <string name="help_generator_action">Open password generator</string>
    <string name="help_settings_action">Open Settings</string>
    <string name="help_backup_title">4. Backups and recovery</string>
    <string name="help_backup_text">A backup contains only encrypted vault.vlt3 and can be stored outside the phone. A new device needs vault.vlt3, the passphrase QR and the RQR2 recovery QR. Both codes can be scanned instead of typed.</string>
    <string name="help_recovery_qr_action">Show RQR2</string>
    <string name="help_recovery_action">Open recovery</string>
