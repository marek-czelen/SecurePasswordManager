    <string name="help_intro">This guide explains the app. The buttons below open the real features so you can try them immediately.</string>
    <string name="help_list_title">1. One entry list</string>
    <string name="help_list_text">Password and image entries appear in one list. Search covers names, logins, URLs, folders and tags.</string>
