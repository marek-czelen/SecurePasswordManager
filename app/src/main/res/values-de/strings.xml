    <string name="privacy_policy_url">https://example.com/securepasswordmanager/privacy</string>
    <string name="privacy_policy_text">SecurePasswordManager verarbeitet Passwörter, Notizen, Passphrasen, QR-Codes, TOTP und Bilder lokal. Der Tresor wird vor dem Speichern verschlüsselt. OCR läuft auf dem Gerät.</string>
    <string name="recovery_qr_title">Wiederherstellungscode</string>
    <string name="recovery_qr_note">RQR2: zufälliges 256-Bit-Geheimnis und authentifizierte Metadaten, niemals der DEK. Getrennt von vault.vlt3 aufbewahren. Wiederherstellung benötigt zusätzlich PIN / Passphrase.</string>
    <string name="passphrase_qr_title">PIN-/Passphrase-QR</string>
    <string name="passphrase_qr_warning">Dieser QR enthält die lesbare Passphrase. Getrennt vom Wiederherstellungscode aufbewahren. Zum Öffnen des Tresors werden weiterhin beide Codes benötigt.</string>
